PORT=5000
NODE_ENV=development

# Postgres (Supabase hoac Postgres tren may)
# Local  : dung Direct connection, cong 5432
# Vercel : dung Transaction pooler, cong 6543
DATABASE_URL=postgresql://user:password@host:5432/dbname

# So ket noi toi da trong pool. Tren Vercel de 1.
DB_POOL_MAX=5

# Bat buoc. Sinh bang: openssl rand -base64 32
JWT_SECRET=

# Chi dat khi frontend o domain khac API
# CORS_ORIGIN=https://example.com
